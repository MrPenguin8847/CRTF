# Required deployment mode. Use demo for public read-only demonstrations.
FLOWTRACE_MODE=demo

# Exact browser origins allowed to call the API; comma-separate multiple origins.
ALLOWED_ORIGINS=http://localhost:3000

# Set to 1 only when FlowTrace is deployed behind one trusted reverse proxy.
TRUST_PROXY=0

# Optional per-process in-memory limits. A shared Redis store is required only
# when running more than one backend instance.
WALLET_RATE_LIMIT_WINDOW_MS=60000
WALLET_RATE_LIMIT_MAX=30
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
ASSISTANT_RATE_LIMIT_MAX=10

# Official OFAC SDN XML export, polled by the backend and cached in memory.
SANCTIONS_FEED_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML
SANCTIONS_FEED_REFRESH_MS=21600000
SANCTIONS_FEED_REQUEST_TIMEOUT_MS=15000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

ALCHEMY_API_KEY=your-alchemy-key
OPENROUTER_API_KEY=your-openrouter-key
